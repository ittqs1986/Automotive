<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- หน้าสำหรับพนักงานส่งข้อเสนอแนะ (ไม่ระบุตัวตน) -->
    <template id="suggestion_form_template" name="Submit Suggestion">
        <t t-call="vehicle_borrow.vb_layout">
            <div id="wrap">
                <section class="py-5 bg-dark text-white">
                    <div class="container text-center">
                        <h2 class="display-4 fw-bold"><i class="fa fa-bullhorn me-3 text-info"/>กล่องรับความคิดเห็น</h2>
                        <p class="lead text-white-50">ส่งข้อเสนอแนะหรือแจ้งปัญหาเกี่ยวกับการใช้รถ (ข้อมูลของคุณจะถูกเก็บเป็นความลับ ไม่ระบุตัวตน)</p>
                    </div>
                </section>
                <section class="py-5 bg-light min-vh-100">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-md-8">
                                <t t-if="request.params.get('msg') == 'success'">
                                    <div class="alert alert-success alert-dismissible fade show shadow-sm text-center py-4" role="alert">
                                        <i class="fa fa-check-circle text-success d-block mb-3" style="font-size: 4rem;"></i>
                                        <h4 class="alert-heading fw-bold">ขอบคุณสำหรับข้อเสนอแนะ!</h4>
                                        <p class="mb-0">ระบบได้รับข้อมูลของท่านเรียบร้อยแล้วและจะนำไปปรับปรุงต่อไป</p>
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                    </div>
                                    <div class="text-center mt-3">
                                        <a href="/automotive" class="btn btn-outline-secondary"><i class="fa fa-arrow-left me-2"></i>กลับสู่หน้าหลัก</a>
                                    </div>
                                </t>
                                <t t-else="">
                                    <t t-if="request.params.get('error')">
                                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                                            <i class="fa fa-exclamation-triangle me-2"></i><t t-esc="request.params.get('error')"/>
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                        </div>
                                    </t>

                                    <div class="card shadow-lg border-0 rounded-4">
                                        <div class="card-body p-5">
                                            <form action="/automotive/suggestion/submit" method="post">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <div class="mb-4">
                                                    <label for="content" class="form-label fw-bold text-dark fs-5">ข้อเสนอแนะของคุณ <span class="text-danger">*</span></label>
                                                    <textarea id="content" name="content" class="form-control form-control-lg" rows="6" required="1" placeholder="พิมพ์ข้อความที่นี่..."></textarea>
                                                    <div class="form-text text-muted mt-3 p-3 bg-light rounded-3 border">
                                                        <i class="fa fa-user-secret me-2 text-primary fs-5 align-middle"></i>
                                                        <span class="align-middle">ข้อมูลนี้จะถูกส่งถึงผู้ดูแลระบบโดยตรง และจะ<b>ไม่มีการบันทึกชื่อผู้ส่ง</b> เพื่อให้คุณสามารถแสดงความคิดเห็นได้อย่างอิสระ</span>
                                                    </div>
                                                </div>
                                                <div class="d-grid mt-4">
                                                    <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-pill shadow-sm py-3">
                                                        <i class="fa fa-paper-plane me-2"></i>ส่งข้อเสนอแนะ
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- หน้าสำหรับ Head Admin / Admin ดูข้อเสนอแนะ -->
    <template id="admin_suggestions_template" name="Admin Suggestions">
        <t t-call="vehicle_borrow.vb_layout">
            <div id="wrap">
                <section class="py-5 bg-dark text-white">
                    <div class="container text-center">
                        <h2 class="display-4 fw-bold"><i class="fa fa-comments-o me-3 text-warning"/>ข้อเสนอแนะจากผู้ใช้งาน</h2>
                        <p class="lead text-white-50">รายการข้อเสนอแนะที่ไม่ระบุตัวตนทั้งหมด (Anonymous Feedback)</p>
                    </div>
                </section>
                <section class="py-5 bg-light min-vh-100">
                    <div class="container pb-5">
                        <div class="card shadow-lg border-0 rounded-4">
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-dark">
                                            <tr>
                                                <th class="ps-4 py-3" style="width: 20%;">วันเวลาที่ส่ง</th>
                                                <th class="py-3" style="width: 15%;">กลุ่มโรงงาน / Role</th>
                                                <th class="py-3">ข้อเสนอแนะ</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="not suggestions">
                                                <tr><td colspan="3" class="text-center py-5 text-muted">ยังไม่มีข้อเสนอแนะ</td></tr>
                                            </t>
                                            <t t-foreach="suggestions" t-as="s">
                                                <tr class="bg-white">
                                                    <td class="ps-4 small text-muted">
                                                        <i class="fa fa-clock-o me-1 text-primary"></i> <t t-esc="s.date.strftime('%d/%m/%Y %H:%M') if s.date else '-'"/>
                                                    </td>
                                                    <td class="small">
                                                        <t t-if="s.factory == 'TQS'">
                                                            <span class="badge bg-primary px-3 py-2 rounded-pill"><i class="fa fa-industry me-1"/>TQS</span>
                                                        </t>
                                                        <t t-elif="s.factory == 'CKR'">
                                                            <span class="badge bg-success px-3 py-2 rounded-pill"><i class="fa fa-industry me-1"/>CKR</span>
                                                        </t>
                                                        <t t-elif="s.factory == 'TPS'">
                                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="fa fa-industry me-1"/>TPS</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-secondary px-3 py-2 rounded-pill"><i class="fa fa-question-circle me-1"/>อื่นๆ</span>
                                                        </t>
                                                    </td>
                                                    <td class="py-3 pe-4">
                                                        <div class="text-dark bg-light p-3 rounded-3 border" style="white-space: pre-wrap;" t-esc="s.content"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
