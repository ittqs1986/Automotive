<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: List -->
    <record id="view_vehicle_borrow_request_list" model="ir.ui.view">
        <field name="name">vehicle.borrow.request.list</field>
        <field name="model">vehicle.borrow.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-warning="state == 'request'" decoration-success="state == 'approved'" decoration-primary="state == 'borrowed'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_user"/>
                <field name="vehicle_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'request'" decoration-success="state == 'approved'" decoration-primary="state == 'borrowed'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- View: Kanban -->
    <record id="view_vehicle_borrow_request_kanban" model="ir.ui.view">
        <field name="name">vehicle.borrow.request.kanban</field>
        <field name="model">vehicle.borrow.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="vehicle_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <div><field name="employee_id"/></div>
                            <div><field name="vehicle_id"/></div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <field name="date_start" widget="date"/>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="state" widget="label_selection" options="{'classes': {'draft': 'info', 'request': 'warning', 'approved': 'success', 'borrowed': 'primary', 'returned': 'secondary', 'cancelled': 'danger'}}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- View: Graph -->
    <record id="view_vehicle_borrow_request_graph" model="ir.ui.view">
        <field name="name">vehicle.borrow.request.graph</field>
        <field name="model">vehicle.borrow.request</field>
        <field name="arch" type="xml">
            <graph string="Borrowing Analysis" sample="1">
                <field name="vehicle_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <!-- View: Pivot -->
    <record id="view_vehicle_borrow_request_pivot" model="ir.ui.view">
        <field name="name">vehicle.borrow.request.pivot</field>
        <field name="model">vehicle.borrow.request</field>
        <field name="arch" type="xml">
            <pivot string="Borrowing Analysis" sample="1">
                <field name="vehicle_id" type="row"/>
                <field name="date_start" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- View: Form -->
    <record id="view_vehicle_borrow_request_form" model="ir.ui.view">
        <field name="name">vehicle.borrow.request.form</field>
        <field name="model">vehicle.borrow.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_request" string="Request" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'request'" class="oe_highlight" groups="fleet.fleet_group_manager"/>
                    <button name="action_borrow" string="Pick up Vehicle" type="object" invisible="state != 'approved'" class="oe_highlight"/>
                    <button name="action_return" string="Return Vehicle" type="object" invisible="state != 'borrowed'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ['returned', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,request,approved,borrowed,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="vehicle_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Information">
                            <group>
                                <field name="purpose" placeholder="Why do you need this car?"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_vehicle_borrow_request_search" model="ir.ui.view">
        <field name="name">vehicle.borrow.request.search</field>
        <field name="model">vehicle.borrow.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="vehicle_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Requested" name="requested" domain="[('state', '=', 'request')]"/>
                <filter string="Current Borrowing" name="borrowed" domain="[('state', '=', 'borrowed')]"/>
                <group>
                    <filter string="Employee" name="employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Vehicle" name="vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="State" name="state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vehicle_borrow_request" model="ir.actions.act_window">
        <field name="name">Borrowing Requests</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">vehicle.borrow.request</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new borrowing request.
            </p>
        </field>
    </record>

    <!-- View: Vehicle Repair Request -->
    <record id="view_vehicle_repair_request_list" model="ir.ui.view">
        <field name="name">vehicle.repair.request.list</field>
        <field name="model">vehicle.repair.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'repairing'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="reported_by_id" widget="many2one_avatar_user"/>
                <field name="report_date"/>
                <field name="state" widget="badge" decoration-danger="state == 'repairing'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_repair_request_form" model="ir.ui.view">
        <field name="name">vehicle.repair.request.form</field>
        <field name="model">vehicle.repair.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" string="แจ้งซ่อมเสร็จ" type="object" invisible="state != 'repairing'" class="oe_highlight"/>
                    <button name="action_cancel" string="ยกเลิก" type="object" invisible="state != 'repairing'"/>
                    <field name="state" widget="statusbar" statusbar_visible="repairing,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id" options="{'no_create': True}"/>
                            <field name="reported_by_id" options="{'no_create': True}" readonly="1"/>
                        </group>
                        <group>
                            <field name="report_date"/>
                            <field name="finish_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="อาการเสีย">
                            <group>
                                <field name="description" placeholder="ระบุอาการเสีย..."/>
                            </group>
                        </page>
                        <page string="รายละเอียดการซ่อม" invisible="state == 'repairing'">
                            <group>
                                <field name="repair_details"/>
                                <field name="parts_used"/>
                                <field name="repair_cost"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vehicle_repair_request" model="ir.actions.act_window">
        <field name="name">รายการแจ้งซ่อม</field>
        <field name="res_model">vehicle.repair.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ยังไม่มีข้อมูลการแจ้งซ่อม
            </p>
        </field>
    </record>
</odoo>
