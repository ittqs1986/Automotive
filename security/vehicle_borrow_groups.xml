<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Application Category -->
        <record id="module_vehicle_borrow" model="ir.module.category">
            <field name="name">Vehicle Borrow System</field>
            <field name="sequence">100</field>
        </record>

        <!-- Head Admin: สามารถเข้าถึงทุกโรงงาน ทุกส่วน -->
        <record id="group_vb_head_admin" model="res.groups">
            <field name="name">Head Admin</field>
            <field name="implied_ids" eval="[(4, ref('fleet.fleet_group_manager'))]"/>
        </record>

        <!-- Admin TQS -->
        <record id="group_vb_admin_tqs" model="res.groups">
            <field name="name">Admin Factory TQS</field>
            <field name="implied_ids" eval="[(4, ref('fleet.fleet_group_manager'))]"/>
        </record>

        <!-- Admin CKR -->
        <record id="group_vb_admin_ckr" model="res.groups">
            <field name="name">Admin Factory CKR</field>
            <field name="implied_ids" eval="[(4, ref('fleet.fleet_group_manager'))]"/>
        </record>

        <!-- Admin TPS -->
        <record id="group_vb_admin_tps" model="res.groups">
            <field name="name">Admin Factory TPS</field>
            <field name="implied_ids" eval="[(4, ref('fleet.fleet_group_manager'))]"/>
        </record>

        <!-- User TQS: พนักงานโรงงาน TQS -->
        <record id="group_vb_user_tqs" model="res.groups">
            <field name="name">User Factory TQS</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- User CKR: พนักงานโรงงาน CKR -->
        <record id="group_vb_user_ckr" model="res.groups">
            <field name="name">User Factory CKR</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- User TPS: พนักงานโรงงาน TPS -->
        <record id="group_vb_user_tps" model="res.groups">
            <field name="name">User Factory TPS</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
