<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_vehicle_borrow_request" model="ir.sequence">
        <field name="name">Vehicle Borrowing Request Sequence</field>
        <field name="code">vehicle.borrow.request</field>
        <field name="prefix">VBR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_vehicle_repair_request" model="ir.sequence">
        <field name="name">Vehicle Repair Request Sequence</field>
        <field name="code">vehicle.repair.request</field>
        <field name="prefix">REP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_vehicle_transfer_request" model="ir.sequence">
        <field name="name">Vehicle Transfer Request Sequence</field>
        <field name="code">vehicle.transfer.request</field>
        <field name="prefix">TRF/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
